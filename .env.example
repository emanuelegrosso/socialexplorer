# Local configuration for SocialExplorer.
# Copy to .env for local development. Never commit .env, SQLite databases,
# connector auth state, tokens, or personal exports.

# Optional Baileys connector feature flag (disabled by default; Archive Import is primary).
ENABLE_BAILEYS_CONNECTOR=false

# Override Electron userData directory during local development (optional).
# Production stores data under OS userData/SocialExplorer.
SOCIALEXPLORER_USER_DATA_DIR=

# Logging level. Logs redact QR codes, pairing codes, tokens, keys, phone numbers,
# full JIDs, and message bodies.
LOG_LEVEL=info
